# Conexión de la aplicación: rol sin privilegios, sujeto a RLS.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:54329/sobremesa
# Conexión de migraciones y scripts administrativos (propietario del esquema).
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@localhost:54329/sobremesa
# Puerto y carpeta del PostgreSQL embebido local (pnpm db:start). La carpeta por defecto
# está fuera de OneDrive para que la sincronización no bloquee archivos de Postgres.
LOCAL_PG_PORT=54329
# LOCAL_PG_DATA_DIR=

BETTER_AUTH_URL=http://localhost:3000
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Sal para guardar IPs como hash en la auditoría.
AUDIT_IP_PEPPER=
# Token que debe enviar el cron que procesa la cola de eventos.
CRON_SECRET=

# En desarrollo, crea .env.development.local con DEV_MAILBOX=1: los correos (códigos OTP,
# invitaciones) se muestran en /dev/correo. Next no carga ese archivo en build ni en producción.
